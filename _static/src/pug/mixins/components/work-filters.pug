mixin work-filters(props = {})
  -
    const filters = [
      {text: 'pets', label: 'Pets', id: 'pet'},
      {text: 'works', label: 'Works', id: 'work'},
      {text: 'webs', label: 'Webs', id: 'web'},
      {text: 'mobiles', label: 'Mobiles', id: 'mobile'},
    ]

  form.work-filters(data-work-filters="parent")&attributes(attributes)
    button.work-filters__reset-trigger(
      type="reset"
      title="Reset all filters"
      aria-label="Reset all filters"
      data-work-filters="reset-trigger"
    ) Reset

    menu.work-filters__panel
      each filter in filters
        - const {text, label, id} = filter

        li.work-filters__item
          label.work-filters__trigger(
            data-work-filters="trigger"
            data-work-filter-id=id
          )= text
            input.visually-hidden(
              type="radio"
              name="work-filters"
              title=`Sort by «${label}»`
              aria-label=`Sort by «${label}»`
              aria-selected="false"
            )
