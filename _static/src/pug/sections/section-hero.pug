mixin section-hero(props = {})
  section.section-hero#section-about&attributes(attributes)
    +ui-code({
      tag: 'h1',
      text: 'Sergey Novikov',
    }).section-hero__title

    menu.section-hero__tags(data-hero-tags="tags-parent")
      each tag in DataHeroTags
        - const { name, shortName, ariaDescribedby } = tag

        li
          +ui-code({
            tag: 'button',
            text: name,
            isColorReverse: true,
          })(
            type="button"
            aria-describedby=ariaDescribedby
            data-short-name=shortName || ''
            data-hero-tags="tag"
          ).section-hero__tag
