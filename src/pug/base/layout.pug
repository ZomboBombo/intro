include ./components

block variables
  -
    let pageId = ''
    let hasHeader = true
    let hasFooter = true

doctype html
html(lang="en")
  head
    title= title
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible" content="ie=edge")

    +metainfo()
    +favicons()

    // Fonts preloading
    link(rel="preload" href="/fonts/inconsolata/Inconsolata-Regular.woff2" as="font" crossorigin="anonymous")
    link(rel="stylesheet" href="/src/sass/styles.scss")

  body
    .site-container(data-sidebar="parent")
      +site-header()
      +site-sidebar()

      .site-container__content
        main.site-main
          block main

          unless pageId === 'page-main'
            a.site-container__back-link(
              href="/"
              title="Back to Main page"
              aria-label="Back to Main page"
            ) Back to Main

        +site-footer({pageId: pageId})

    .site-modals(aria-hidden="true")
      block modals

    script(src="/src/js/main.ts" type="module")
