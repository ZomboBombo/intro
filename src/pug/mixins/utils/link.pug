mixin link(props = {})
  -
    const {
      href,
      isExternal,
      hasVisibleTooltip,
      tooltip,
      text,
    } = props
    const target = isExternal && '_blank'
    const rel = isExternal && 'noopener noreferrer'

  a(
    href=href
    target=target
    rel=rel
    title=hasVisibleTooltip && tooltip
    aria-label=tooltip
  )&attributes(attributes)= text
