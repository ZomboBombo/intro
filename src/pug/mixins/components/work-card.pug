mixin work-card(props = {})
  -
    const {
      pic,
      name,
      descr,
      tags,
      repoLink = false,
      demoLink = false,
      realLink = false,
    } = props
    const picName = pic?.name || 'content/pic-placeholder'
    const picExt = pic?.ext || 'png'
    const picAlt = pic?.alt || false

  article.work-card(data-work-card="parent")&attributes(attributes)
    +picture({
      width: 300,
      height: 300,
      name: picName,
      ext: picExt,
      alt: picAlt,
    }).work-card__preview

    .work-card__info
      hgroup.work-card__head
        h3.work-card__title= name
        p.work-card__descr= descr

      menu.work-card__links-list
        if repoLink
          li
            +link({
              href: repoLink,
              isExternal: true,
              tooltip: `Go to the repository with the «${name}» sources`,
              text: '> Goto repo',
            }).work-card__link

        if demoLink
          li
            +link({
              href: demoLink,
              isExternal: true,
              tooltip: `Go to the «${name}» demonstration`,
              text: '> Watch demo',
            }).work-card__link

        if realLink
          li
            +link({
              href: realLink,
              isExternal: true,
              tooltip: `Open the «${name}» real project`,
              text: '> Open Work',
            }).work-card__link

      ul.work-card__tags-list
        each tag in tags
          li.work-card__tag(data-work-card="tag")= tag
