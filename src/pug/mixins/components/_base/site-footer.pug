mixin site-footer(props = {})
  - const {pageId} = props

  footer.site-footer&attributes(attributes)
    nav.site-footer__nav
      menu.site-footer__nav-menu
        each navItem in DataMainNavigation          
          -
            const {dataPageId, href, tooltip, text} = navItem
            const isCurrentPage = dataPageId === pageId

          li.site-footer__nav-menu-item
            a.site-footer__nav-menu-link(
              href=isCurrentPage ? false : (href || '#')
              aria-current=isCurrentPage ? 'page' : false
              aria-label=tooltip
              data-value=text
            )= text

    +copyright({year: '2025'}).site-footer__copyright
