mixin site-sidebar(props = {})
  aside.site-sidebar(id="site-sidebar" data-sidebar="sidebar")&attributes(attributes)
    button.site-sidebar__trigger(
      type="button"
      title="Open the sidebar with additional info"
      aria-label="Open the sidebar with additional info"
      aria-pressed="false"
      aria-expanded="false"
      aria-controls="site-sidebar"
      data-tooltip="Open the sidebar with additional info"
      data-sidebar="trigger"
      data-sidebar-text-open="Open the sidebar with additional info"
      data-sidebar-text-close="Close sidebar"
    )
      +icon({
        width: 45,
        height: 45,
        name: 'icn-logo',
      })

    nav.site-sidebar__nav
      +socials-list({
        listClass: 'site-sidebar__nav-list',
        listLinkClass: 'site-sidebar__nav-link',
        links: DataSocialsNavigation,
      })

    footer.site-sidebar__footer
      +color-scheme-switcher()
      +copyright({year: '2025'})
      +ui-build-ver()
