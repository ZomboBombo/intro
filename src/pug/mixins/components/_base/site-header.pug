mixin site-header(props = {})
  header.site-header&attributes(attributes)
    nav.site-header__nav
      a.site-header__logo(
        href="/"
        title="Back to Main page"
        aria-label="Back to Main page"
      )
        +icon({
          width: 100,
          height: 100,
          name: 'icn-logo',
        })

      +socials-list({
        listClass: 'site-header__nav-list',
        listItemClass: 'site-header__nav-item',
        listLinkClass: 'site-header__nav-link',
        links: DataSocialsNavigation,
      })#site-header-nav-menu(data-burger-menu="menu")

      .site-header__controls
        +color-scheme-switcher()

        button.site-header__burger(
          type="button"
          aria-label="Open Socials navigation menu"
          aria-pressed="false"
          aria-expanded="false"
          aria-controls="site-header-nav-menu"
          data-burger-menu="burger"
          data-burger-tt-close="Open Socials navigation menu"
          data-burger-tt-open="Close menu"
        ) Nav Menu Trigger
