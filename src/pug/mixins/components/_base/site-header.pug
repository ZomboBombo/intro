mixin site-header(props = {})
  header.site-header&attributes(attributes)
    nav.site-header__nav
      a.site-header__logo(href="/")
        +icon({
          width: 100,
          height: 100,
          name: 'icn-logo',
        })

      ul.site-header__nav-menu(id="site-header-nav-menu" data-burger-menu="menu")
        each navItem in DataSocialsNavigation
          -
            const href = navItem.href || '#'
            const tooltip = navItem.tooltip || false

          li.site-header__nav-menu-item
            a.site-header__nav-menu-link(
              href=href
              aria-label=tooltip
              data-burger-menu="link"
            )= navItem.text

      .site-header__controls
        +color-scheme-switcher()

        button.site-header__burger(
          type="button"
          aria-label="Open Socials navigation menu"
          aria-pressed="false"
          aria-expanded="false"
          aria-controls="site-header-nav-menu"
          data-burger-menu="burger"
          data-burger-tt-close="Open Socials navigation menu"
          data-burger-tt-open="Close menu"
        ) Nav Menu Trigger
